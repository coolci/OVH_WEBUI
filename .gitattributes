# Shell scripts and Go/TS sources must use LF for cross-platform formatting consistency
*.sh text eol=lf
server/docker-entrypoint.sh text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts
*.ps1 text eol=crlf
