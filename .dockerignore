# git / IDE
.git
.gitignore
.idea
.vscode
**/.DS_Store

# local env & secrets (injected via compose env_file, never bake into image)
.env
.env.*
server/.env
server/.env.*
secrets

# runtime data (volume mounted)
server/data
server/data/**
data
**/*.db
**/*.db-*

# binaries / build
**/node_modules
**/dist
**/*.exe
**/*.exe~
**/ovh-webui
server/ovh-webui*
server/web
**/*.test
**/*.out
**/coverage
**/*.tsbuildinfo

# docs / scripts / local artifacts not needed in image
docs
scripts
artifacts
deploy_package.tar.gz
**/*.md
!web/package.json
!web/package-lock.json
